generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  mentor
  coaching_partner
  telegram_partner
  other_partner
}

enum MentorLevel {
  Verified
  Standard
  Signature
  Fellow
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String?   @unique
  phone           String?    @unique
  isPhoneVerified Boolean   @default(false)
  isEmailVerified Boolean   @default(false)
  authProvider    String    @default("email")
  name            String?
  role            UserRole
  grade           String?
  photo_url       String?
  coachingCenterId String?   @db.Uuid
  isFreeAvailable Boolean?
  created_at      DateTime  @default(now())
  profile_completed Boolean @default(false)
  favouriteMentors String[] @default([])
  
  mentorProfile  MentorProfile?
  wallet         Wallet?
  mentorBalance  MentorBalance?
  coachingCenter CoachingCenter? @relation(fields: [coachingCenterId], references: [id])
  partnerBalance PartnerBalance?

  // Partner / Referral system fields
  referralCode           String?   @unique
  referredByReferralCode String?
  commissionMethod       String?   // 'per_signup' or 'percent_revenue'
  commissionValue        Decimal?  @db.Decimal(10, 2)
  studentBonusValue      Decimal?  @db.Decimal(10, 2)
  createdBy              String?   // Email of admin who created it

  referredBy             User?     @relation("UserReferrals", fields: [referredByReferralCode], references: [referralCode])
  referredUsers          User[]    @relation("UserReferrals")
  
  callSessionsStudent CallSession[] @relation("StudentCalls")
  callSessionsMentor  CallSession[] @relation("MentorCalls")
  
  ratingsStudent Rating[] @relation("StudentRatings")
  ratingsMentor  Rating[] @relation("MentorRatings")

  payouts        Payout[]
  refreshTokens  RefreshToken[]
  fcmTokens      FCMToken[]
  notifications  Notification[]
  chatSessionsStudent ChatSession[] @relation("StudentChatSessions")
  chatSessionsMentor  ChatSession[] @relation("MentorChatSessions")
  chatMessages        ChatMessage[]
  questions           Question[]
  answers             Answer[]

  voucherEligible     Boolean @default(false)
  voucherSubscriptions VoucherSubscription[]

  @@map("users")
}

model VoucherSubscription {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  plan              String    // "3000" or "6000"
  amountPaid        Decimal   @db.Decimal(10, 2)
  totalCredit       Decimal   @db.Decimal(10, 2)
  installmentsRemaining Int   @default(6)
  amountPerInstallment  Decimal @db.Decimal(10, 2)
  status            String    @default("active")  // active, completed, cancelled
  razorpayOrderId   String?
  razorpayPaymentId String?
  nextCreditDate    DateTime?
  purchasedAt       DateTime  @default(now())
  completedAt       DateTime?
  
  user              User      @relation(fields: [userId], references: [id])
  
  @@map("voucher_subscriptions")
}

model FCMToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fcm_tokens")
}

model CoachingCenter {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  code            String    @unique
  commission_rate Decimal   @default(0.05) @db.Decimal(3, 2)
  created_at      DateTime  @default(now())

  students        User[]
  balance         CoachingCenterBalance?

  @@map("coaching_centers")
}

model CoachingCenterBalance {
  centerId       String    @id @db.Uuid
  pendingPayout  Decimal   @default(0) @db.Decimal(10, 2)
  totalEarned    Decimal   @default(0) @db.Decimal(10, 2)
  totalWithdrawn Decimal   @default(0) @db.Decimal(10, 2)

  coachingCenter CoachingCenter @relation(fields: [centerId], references: [id])

  @@map("coaching_center_balances")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model MentorProfile {
  mentorId       String      @id @db.Uuid
  iit_name       String
  branch         String?
  year           Int?
  verificationStatus VerificationStatus @default(PENDING)
  mentorlevel    MentorLevel?
  verified_by    String?
  verified_at    DateTime?
  id_doc_url     String?
  upiId          String?     @map("upi_id")
  bio            String?
  expertise      String
  languages      String?
  rate_per_min   Decimal     @default(7.00) @db.Decimal(6, 2)
  avg_rating     Decimal     @default(0) @db.Decimal(3, 2)
  total_calls    Int         @default(0)
  isOnline       Boolean     @default(false)
  lastOnlineAt   DateTime?
  
  user           User        @relation(fields: [mentorId], references: [id])

  @@map("mentor_profiles")
}

model MentorPromotionCondition {
  id          String      @id @default(uuid()) @db.Uuid
  level       MentorLevel @unique
  minCalls    Int?        @default(0) @map("min_calls")
  minRating   Decimal?    @default(0) @db.Decimal(3, 2) @map("min_rating")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("mentor_promotion_conditions")
}

model Wallet {
  userId         String    @id @db.Uuid
  balance        Decimal   @default(0) @db.Decimal(10, 2)
  updatedAt      DateTime  @default(now()) @map("updated_at")

  user           User      @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model MentorBalance {
  mentorId       String    @id @db.Uuid
  pendingPayout  Decimal   @default(0) @db.Decimal(10, 2)
  totalEarned    Decimal   @default(0) @db.Decimal(10, 2)
  totalWithdrawn Decimal   @default(0) @db.Decimal(10, 2)

  user           User      @relation(fields: [mentorId], references: [id])

  @@map("mentor_balances")
}

model WalletTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  type              String   
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

model CallSession {
  id              String    @id @default(uuid()) @db.Uuid
  student_id      String    @db.Uuid
  mentor_id       String    @db.Uuid
  agoraChannelId  String?   @map("agora_channel_id")
  status          String    @default("pending")
  scheduledAt     DateTime? @map("scheduled_at")
  scheduledDuration Int?    @map("scheduled_duration")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSecs    Int       @default(0) @map("duration_secs")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  amountCharged   Decimal   @default(0) @db.Decimal(10, 2) @map("amount_charged")
  mentorEarning   Decimal   @default(0) @db.Decimal(10, 2) @map("mentor_earning")
  platformFee     Decimal   @default(0) @db.Decimal(10, 2) @map("platform_fee")
  ratePerMin      Decimal?  @default(0) @db.Decimal(10, 2) @map("rate_per_min")
  is_free         Boolean   @default(false)
  settledAt       DateTime? @map("settled_at")
  recordingUrl    String?   @map("recording_url")
  createdAt       DateTime  @default(now()) @map("created_at")

  student         User      @relation("StudentCalls", fields: [student_id], references: [id])
  mentor          User      @relation("MentorCalls", fields: [mentor_id], references: [id])
  rating          Rating?
  chatSessions    ChatSession[]

  @@map("call_sessions")
}

model ChatSession {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid @map("student_id")
  mentorId     String   @db.Uuid @map("mentor_id")
  agoraConvId  String   @unique @map("agora_conv_id")  // Agora conversation ID
  status       String   @default("active") @db.VarChar(20)  // active, archived, blocked
  initiatedAt  DateTime @default(now()) @map("initiated_at")
  lastMessageAt DateTime? @map("last_message_at")
  messageCount Int      @default(0) @map("message_count")
  isInCallChat Boolean  @default(false) @map("is_in_call_chat")  // Track if tied to call
  callSessionId String? @db.Uuid @map("call_session_id")

  student     User         @relation("StudentChatSessions", fields: [studentId], references: [id])
  mentor      User         @relation("MentorChatSessions", fields: [mentorId], references: [id])
  callSession CallSession? @relation(fields: [callSessionId], references: [id])
  messages    ChatMessage[]

  @@unique([studentId, mentorId])  // One chat per student-mentor pair
  @@index([studentId])
  @@index([mentorId])
  @@map("chat_sessions")
}

model ChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  chatSessionId   String   @db.Uuid @map("chat_session_id")
  agoraMsgId      String   @unique @map("agora_msg_id")  // Agora message ID
  senderId        String   @db.Uuid @map("sender_id")
  content         String   @db.Text
  msgType         String   @default("text") @db.VarChar(20)  // text, image, system
  status          String   @default("sent") @db.VarChar(20)  // sent, delivered, read, blocked
  validatedAt     DateTime? @map("validated_at")
  validationResult Json?   @map("validation_result")  // Store validation details
  createdAt       DateTime @default(now()) @map("created_at")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id])

  @@index([chatSessionId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model ChatValidationRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  ruleType    String   @db.VarChar(50)  // pii, url, rate_limit, profanity, custom
  pattern     String?  @db.Text  // Regex pattern
  config      Json?    // Rule-specific config (e.g., max messages/min)
  action      String   @default("block") @db.VarChar(20)  // block, flag, warn
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("chat_validation_rules")
}

model ChatRateLimit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  windowStart DateTime @map("window_start")
  messageCount Int   @default(1) @map("message_count")
  windowType String   @db.VarChar(20)  // minute, hour, day

  @@unique([userId, windowType, windowStart])
  @@index([userId, windowType])
  @@map("chat_rate_limits")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")
  actionType   String?  @map("action_type")
  actionTarget String?  @map("action_target")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationLog {
  id             String   @id @default(uuid()) @db.Uuid
  sender         String
  received_by_id String[]
  title          String
  body           String   @db.Text
  sent_at        DateTime @default(now())
  actionType     String?  @map("action_type")
  actionTarget   String?  @map("action_target")

  @@map("notification_logs")
}

model Rating {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @unique @db.Uuid
  studentId   String?  @db.Uuid
  mentorId    String?  @db.Uuid
  score       Int
  comment     String?
  createdAt   DateTime @default(now())

  session     CallSession @relation(fields: [sessionId], references: [id])
  student     User?       @relation("StudentRatings", fields: [studentId], references: [id])
  mentor      User?       @relation("MentorRatings", fields: [mentorId], references: [id])

  @@map("ratings")
}

model Payout {
  id                String   @id @default(uuid()) @db.Uuid
  mentorId          String   @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  razorpayPayoutId  String?  @unique
  status            String   @default("pending")
  tdsDeducted       Decimal  @default(0) @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  // The relation field causing the error:
  mentor            User     @relation(fields: [mentorId], references: [id])

  @@map("payouts")
}

model EmailLog {
  id             String   @id @default(uuid()) @db.Uuid
  sender         String
  received_by_id String[]
  subject        String
  body           String   @db.Text
  sent_at        DateTime @default(now())

  @@map("email_logs")
}

model Question {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @db.Uuid
  text             String   @db.Text
  isDeleted        Boolean  @default(false) @map("is_deleted")
  coachingCenterId String?  @db.Uuid @map("coaching_center_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers          Answer[]

  @@map("questions")
}

model Answer {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  mentorId   String   @db.Uuid
  text       String   @db.Text
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mentor     User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  votes      AnswerVote[]

  @@unique([questionId, mentorId])
  @@map("answers")
}

model AnswerVote {
  id        String   @id @default(uuid()) @db.Uuid
  answerId  String   @db.Uuid
  userId    String   @db.Uuid
  voteType  String   
  createdAt DateTime @default(now()) @map("created_at")

  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@map("answer_votes")
}

model AskConfig {
  id                     String   @id @default("default")
  maxQuestionsPerPeriod  Int      @default(5)
  periodHours            Int      @default(24)
  maxQuestionChars       Int?     @map("maxQuestionWords")
  maxAnswerChars         Int?

  @@map("ask_configs")
}

model PartnerBalance {
  partnerId      String    @id @db.Uuid
  pendingPayout  Decimal   @default(0) @db.Decimal(10, 2)
  totalEarned    Decimal   @default(0) @db.Decimal(10, 2)
  totalWithdrawn Decimal   @default(0) @db.Decimal(10, 2)

  user           User      @relation(fields: [partnerId], references: [id])

  @@map("partner_balances")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

model LogEntry {
  id         String   @id @default(uuid()) @db.Uuid
  level      String   @db.VarChar(10)  // INFO, WARN, ERROR, DEBUG
  message    String   @db.Text
  source     String   @db.VarChar(50)  // "backend", "admin-backend", "gateway"
  instanceId String?  @db.VarChar(100) // Render instance ID or "local"
  method     String?  @db.VarChar(10)  // GET, POST, etc.
  endpoint   String?  @db.Text         // Route path / URL
  status     Int?     // HTTP status code
  duration   Int?     // milliseconds taken
  ip         String?  @db.VarChar(45)  // IP address
  metadata   Json?    // extra details, payload, error stack trace
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level])
  @@index([source])
  @@index([instanceId])
  @@index([method])
  @@index([status])
  @@map("log_entries")
}